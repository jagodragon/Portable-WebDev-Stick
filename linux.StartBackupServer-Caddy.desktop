[Desktop Entry]
Type=Application
Name=Start Backup Web Server (Caddy Fallback)
Comment=Fires up background PHP and boots your backup Caddy proxy engine
Exec=bash -c 'USB_ROOT=$PWD; (cd "$USB_ROOT/Servers-linux/php-desktop" && ./php-bin -S 127.0.0.1:9000 -t "$USB_ROOT/www" &); sleep 1 && xdg-open http://127.0.0.1:8080 && cd "$USB_ROOT/Servers-linux/caddy-server" && ./caddy_linux_amd64 run --config "$USB_ROOT/SharedSettings/Caddyfile"'
Icon=network-wired
Terminal=true

