# See: man pkg-config
prefix=/home/jago_dragon/Portable-Python/install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Python
Description: Build a C extension for Python
Requires:
Version: 3.14
Libs.private: -ldl 
Libs: -L${libdir} 
Cflags: -I${includedir}/python3.14
