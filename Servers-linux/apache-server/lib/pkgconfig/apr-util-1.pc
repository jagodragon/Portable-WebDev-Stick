prefix=/run/media/jago_dragon/WebDev/Servers-linux/apache-server
exec_prefix=/run/media/jago_dragon/WebDev/Servers-linux/apache-server
libdir=${prefix}/lib
APRUTIL_MAJOR_VERSION=1
includedir=/run/media/jago_dragon/WebDev/Servers-linux/apache-server/include

Name: APR Utils
Description: Companion library for APR
Version: 1.6.5
# assume that apr-util requires libapr of same major version
Requires: apr-1
Libs: -L${libdir} -laprutil-${APRUTIL_MAJOR_VERSION}  -lexpat
Cflags: -I${includedir}
