@echo off
setlocal EnableExtensions EnableDelayedExpansion
rem ===========================================================================
rem  a.Ports.FixConflicts.bat - the port decider (Windows).
rem
rem  For every service in the stack, this tests the default port declared in
rem  SharedSettings\Ports.Default.conf. A port that is free is kept. A port
rem  that is already in use is replaced by the first free port in that
rem  service's [DefaultRanges] span. The decided set is written to
rem  SharedSettings\Ports.InUse.conf, and from then on every start/stop
rem  script uses those ports automatically.
rem
rem  The decision is all-or-nothing: if any service has no free port in its
rem  range, nothing is written and the previous state is kept.
rem
rem  Run it while the stack is STOPPED. The decider refuses to run while a
rem  stack server is alive: it would mistake the stack's own ports for
rem  conflicts, and the stop scripts must always be able to find the servers
rem  they started.
rem
rem  To undo a decision, run a.Ports.UseDefaults (it deletes Ports.InUse.conf).
rem ===========================================================================

set "USB_ROOT=%~dp0"
set "SETTINGS=%USB_ROOT%SharedSettings"
set "DEFAULTS=%SETTINGS%\Ports.Default.conf"
set "INUSE=%SETTINGS%\Ports.InUse.conf"
set "DATA_DIR=%USB_ROOT%SharedFolders\data"

echo "This takes a minute or two some times. Be patient please."

if not exist "%DEFAULTS%" (
    echo *** Ports.Default.conf not found in SharedSettings - is this script at the stick root?
    goto :fail
)

rem ---- Preflight: refuse while any stack server is alive ---------------------
if exist "%DATA_DIR%" (
    for %%F in ("%DATA_DIR%\*.pid") do (
        set "PID="
        set /p PID=<"%%F"
        if defined PID (
            tasklist /FI "PID eq !PID!" /NH 2>nul | findstr /B /C:"!PID!" >nul
            if not errorlevel 1 (
                echo *** a stack server is still running ^(pid !PID!^). Stop the stack first -
                echo *** ports are decided while the stack is down.
                goto :fail
            )
        )
    )
)

rem ---- Decide ----------------------------------------------------------------
for %%K in (WEB MARIADB REDIS FPM NODE) do (
    set "KEY=%%K"
    call :builtin_port !KEY! DEF_PORT
    call :conf_get "%DEFAULTS%" DefaultPorts !KEY! GOT_PORT
    if defined GOT_PORT (
        call :is_number !GOT_PORT! OKN
        if "!OKN!"=="1" ( set "DEF=!GOT_PORT!" ) else ( set "DEF=!DEF_PORT!" )
    ) else (
        echo Warning: no usable !KEY! entry in [DefaultPorts]; using the built-in default !DEF_PORT!.
        set "DEF=!DEF_PORT!"
    )
    call :port_taken !DEF! TAKEN
    set "USED_CHK="
    if defined USED_!DEF! set "USED_CHK=1"
    if "!TAKEN!"=="0" if not defined USED_CHK (
        set "RES_!KEY!=!DEF!"
        set "NOTE_!KEY!=default"
        set "USED_!DEF!=1"
    ) else (
        call :builtin_range !KEY! DEF_RANGE
        call :conf_get "%DEFAULTS%" DefaultRanges !KEY! GOT_RANGE
        if defined GOT_RANGE ( set "RANGE=!GOT_RANGE!" ) else ( set "RANGE=!DEF_RANGE!" )
        for /f "tokens=1,2 delims=-" %%A in ("!RANGE!") do ( set "LO=%%A" & set "HI=%%B" )
        set "FOUND="
        for /l %%P in (!LO!,1,!HI!) do (
            if not defined FOUND (
                if not defined USED_%%P (
                    call :port_taken %%P TK2
                    if "!TK2!"=="0" set "FOUND=%%P"
                )
            )
        )
        if not defined FOUND (
            echo *** no free port for !KEY! in range !RANGE!. Free a port, or widen
            echo *** the range in Ports.Default.conf. Nothing was written.
            goto :fail
        )
        set "RES_!KEY!=!FOUND!"
        set "NOTE_!KEY!=!DEF! was in use"
        set "USED_!FOUND!=1"
    )
)

rem ---- Write (all-or-nothing, replace in one move) ----------------------------
> "%INUSE%.tmp" (
    echo # Ports.InUse.conf - generated by a.Ports.FixConflicts; do not hand-edit.
    echo # Run a.Ports.UseDefaults to delete this file and return to Ports.Default.conf.
    echo SESSION=%DATE% %TIME% on %COMPUTERNAME%
    echo.
    echo [InUsePorts]
    echo WEB=%RES_WEB%
    echo MARIADB=%RES_MARIADB%
    echo REDIS=%RES_REDIS%
    echo FPM=%RES_FPM%
    echo NODE=%RES_NODE%
)
if errorlevel 1 (
    echo *** could not write to SharedSettings.
    goto :fail
)
move /y "%INUSE%.tmp" "%INUSE%" >nul
if errorlevel 1 (
    echo *** could not replace Ports.InUse.conf.
    goto :fail
)

echo Ports decided:
for %%K in (WEB MARIADB REDIS FPM NODE) do (
    if "!NOTE_%%K!"=="default" (
        echo   %%K = !RES_%%K!  ^(default, free^)
    ) else (
        echo   %%K = !RES_%%K!  ^(!NOTE_%%K!^)
    )
)
echo.
echo Written to SharedSettings\Ports.InUse.conf. Start the stack the normal
echo way - the launchers read the decided ports from that file.
goto :end

rem ===========================================================================
:conf_get  file section key outvar - read one value from a conf file
set "%~4="
set "CG_FILE=%~1"
set "CG_SEC=%~2"
set "CG_KEY=%~3"
for /f "usebackq delims=" %%V in (`powershell -NoProfile -Command "$sec=''; foreach($l in [IO.File]::ReadLines($env:CG_FILE)){ $t=$l.Trim(); if($t.StartsWith('[')){ $sec=$t.Trim('[',']') } elseif($sec -eq $env:CG_SEC){ $kv=$t -split '=',2; if($kv.Count -eq 2 -and $kv[0].Trim() -eq $env:CG_KEY){ $v=($kv[1] -split '[;#]')[0].Trim(); Write-Output $v; break } } }"`) do set "%~4=%%V"
exit /b

:port_taken  port outvar - 1 if something is listening on 127.0.0.1:port
set "PT_PORT=%~1"
powershell -NoProfile -Command "try{ $c=New-Object Net.Sockets.TcpClient; $c.Connect('127.0.0.1',[int]$env:PT_PORT); $c.Close(); exit 1 } catch { exit 0 }"
if errorlevel 1 ( set "%~2=1" ) else ( set "%~2=0" )
exit /b

:is_number  value outvar
set "%~2=1"
for /f "delims=0123456789" %%X in ("%~1") do set "%~2=0"
if "%~1"=="" set "%~2=0"
exit /b

:builtin_port  key outvar
if "%~1"=="WEB" set "%~2=8080"
if "%~1"=="MARIADB" set "%~2=3306"
if "%~1"=="REDIS" set "%~2=6379"
if "%~1"=="FPM" set "%~2=9000"
if "%~1"=="NODE" set "%~2=3000"
exit /b

:builtin_range  key outvar
if "%~1"=="WEB" set "%~2=8080-8084"
if "%~1"=="MARIADB" set "%~2=3306-3310"
if "%~1"=="REDIS" set "%~2=6379-6383"
if "%~1"=="FPM" set "%~2=9000-9004"
if "%~1"=="NODE" set "%~2=3000-3004"
exit /b

:fail
pause
endlocal
exit /b 1

:end
pause
endlocal
exit /b 0
